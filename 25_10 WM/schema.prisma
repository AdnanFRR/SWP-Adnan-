datasource db {
  provider = "sqlite"
  url      = "file:../dev.db"
}

generator client {
  provider = "prisma-client"
  output   = "client"
  runtime  = "deno"
}

model Player {
  id           Int        @id @default(autoincrement())
  name         String
  position     String?
  mannschaftId Int
  mannschaft   Mannschaft  @relation(fields: [mannschaftId], references: [id])
}

model Mannschaft {
  id       Int       @id @default(autoincrement())
  name     String
  players  Player[]
  matchesA Match[]    @relation("TeamA")
  matchesB Match[]    @relation("TeamB")
}

model Match {
  id           Int        @id @default(autoincrement())
  datum        DateTime
  ergebnis     String?
  stadionId    Int
  stadion      Stadion    @relation(fields: [stadionId], references: [id])
  mannschaftAId Int
  mannschaftBId Int
  mannschaftA  Mannschaft @relation("TeamA", fields: [mannschaftAId], references: [id])
  mannschaftB  Mannschaft @relation("TeamB", fields: [mannschaftBId], references: [id])
}

model Stadion {
  id      Int      @id @default(autoincrement())
  name    String
  stadt   String
  matches Match[]
}